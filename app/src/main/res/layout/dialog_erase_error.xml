<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="46dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_handle" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bgh_circle_red"
        android:contentDescription="擦除失败"
        android:padding="13dp"
        android:src="@drawable/ic_alert" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="芯片擦除失败"
        android:textColor="#F2F2F6"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="耗时 0.0s"
        android:textColor="#9A9AA4"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_err_banner"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:text="擦除失败"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="排查建议"
        android:textColor="#E4E4EC"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="5dp"
        android:text="• 整片擦除一般要几十秒，中途别拔线、别切后台。\n• 报“超时”多半是 USB 线或转接头不稳，换口再试。\n• 一直连不上就按住板子 BOOT 键，再点一下 RST 后重试。\n• 日志里会写明容量、模式和读回结果，方便判断卡在哪一步。"
        android:textColor="#B9B9C4"
        android:textSize="13.5sp" />

    <LinearLayout
        android:id="@+id/detailToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="擦除过程日志"
            android:textColor="#8A8798"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/detailArrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="展开"
            android:src="@drawable/ic_arrow_down"
            android:tint="#6E6E7C" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_result_info"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:textColor="#9A9AA4"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ghost_pill"
            android:gravity="center"
            android:text="复制日志"
            android:textColor="#E2E2EA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_light_pill"
            android:gravity="center"
            android:text="我知道了"
            android:textColor="#16213A"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
