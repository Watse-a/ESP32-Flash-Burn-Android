<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- 标题 + 更多 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="串口日志"
            android:textColor="#E9E6F4"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- 设备 + 设置/清屏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/serialStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="串口设备没有连接"
                android:textColor="#ADADBC"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/tuneButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tune" />

            <ImageButton
                android:id="@+id/clearButton"
                android:layout_width="64dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_chip"
                android:contentDescription="清屏"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_trash_small" />
        </LinearLayout>

        <!-- 展开的设置面板 -->
        <LinearLayout
            android:id="@+id/optionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="波特率"
                    android:textColor="#ADADBC"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/baudSpinner"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#2A2D33" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/modeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#AECBFA"
                    android:checked="true"
                    android:text="文本模式"
                    android:textColor="#E9E6F4"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/modeHex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#AECBFA"
                    android:text="十六进制"
                    android:textColor="#E9E6F4"
                    android:textSize="14sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#AECBFA"
                    android:text="时间戳显示"
                    android:textColor="#E9E6F4"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbChunkNewline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#AECBFA"
                    android:text="分包换行"
                    android:textColor="#E9E6F4"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 接收区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_log">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/serialLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2.5dp"
                android:padding="14dp"
                android:textColor="#E7B24A"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>
    </FrameLayout>

    <!-- 发送区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputText"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="输入要发送的文本…"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#E9E6F4"
            android:textColorHint="#6E6A7E"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/sendButton"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_send"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="发送"
                android:src="@drawable/ic_send" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="发送"
                android:textColor="#9A9AA4"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
